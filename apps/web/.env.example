# ==============================================================================
# apps/web — Next.js Frontend Public Environment Variables
# All NEXT_PUBLIC_* variables are embedded into the browser bundle at build time.
# NEVER place secrets here.
# ==============================================================================

# Required: Public Express API URL (no trailing slash)
NEXT_PUBLIC_API_URL=https://api-complaints.nomaanos.org

# Optional: Public AI service URL for homepage health indicator (leave empty if AI is private/internal)
NEXT_PUBLIC_AI_URL=

# Optional (Provider-obtained): Google OAuth Client ID (public identifier)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Required for Razorpay Checkout modal (Provider-obtained): Razorpay Key ID (public key only)
NEXT_PUBLIC_RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
