# ==============================================================================
# services/ai — Python FastAPI AI Service Environment Variables (Server-Only)
# ==============================================================================

# Required: Shared secret verified on POST /analyze via x-ai-service-token header
AI_SERVICE_SECRET=replace-with-internal-random-shared-secret

# Required: 'gemini' or 'openai' ('ollama' is for local dev only)
AI_PROVIDER=gemini

# Google Gemini (Provider-obtained — offers a free API tier with rate limits)
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI (Provider-obtained — requires prepaid API credits)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Local development only (do not use in cloud free-tier deployment)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.8:27b
OLLAMA_TIMEOUT_SECONDS=300
