# ==============================================================================
# NomaanOS AI Complaint Solver — Environment Variables Reference (Placeholders Only)
# NEVER commit real .env files or real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DOCKER / DATABASE (Backend-only)
# ------------------------------------------------------------------------------
# Required in production (Neon / PostgreSQL connection string with ?sslmode=require)
DATABASE_URL=postgresql://nomaanos:change-this-local-password@db:5432/nomaanos
POSTGRES_DB=nomaanos
POSTGRES_USER=nomaanos
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5435

# ------------------------------------------------------------------------------
# 2. BACKEND API CORE & SECRETS (services/api — NEVER expose to frontend)
# ------------------------------------------------------------------------------
# Required: 'development' locally, 'production' when deployed
NODE_ENV=development
API_PORT=4000
# Required: 32+ random bytes (base64) for Express session signing
SESSION_SECRET=replace-with-48-byte-base64-random-secret
# Required: Exact frontend origin for CORS & OAuth/Email links (e.g. https://complaints.nomaanos.org)
WEB_ORIGIN=http://localhost:3000
# Required: Base URL for hosted public contact forms (e.g. https://complaints.nomaanos.org/contact)
PUBLIC_FORM_BASE_URL=http://localhost:3000/contact
# Optional (required for Meta/WhatsApp webhooks): Public API origin (e.g. https://api-complaints.nomaanos.org)
PUBLIC_API_BASE_URL=
# Optional (required for webhook/inbound-email encryption): 32-byte base64 key
INTEGRATION_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# ------------------------------------------------------------------------------
# 3. SERVICE-TO-SERVICE AI AUTH (Backend API <-> AI Service)
# ------------------------------------------------------------------------------
# Required in production for API -> AI calls (e.g. https://<ai-service>.koyeb.app)
AI_SERVICE_URL=http://ai:8000
# Required in production: Shared secret sent in x-ai-service-token header
AI_SERVICE_SECRET=replace-with-internal-random-shared-secret
# Optional: Timeout in ms for AI classification requests (default: 30000)
AI_SERVICE_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 4. AI SERVICE PROVIDER KEYS (services/ai — NEVER expose to frontend)
# ------------------------------------------------------------------------------
# Required: 'gemini' or 'openai' (or 'ollama' for local dev only)
AI_PROVIDER=openai
# Provider-obtained (OpenAI):
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-6.1-sol
# Provider-obtained (Google Gemini):
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
# Local dev only (Ollama):
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.8:27b
AI_PORT=8001

# ------------------------------------------------------------------------------
# 5. EMAIL DELIVERY — RESEND (Backend-only secrets, Provider-obtained)
# ------------------------------------------------------------------------------
# Required in production for verification & password-reset emails:
EMAIL_FROM=NomaanOS <onboarding@resend.dev>
RESEND_API_KEY=replace-with-your-resend-api-key
# Optional (for inbound email ingestion):
RESEND_WEBHOOK_SECRET=replace-with-your-resend-email.received-webhook-signing-secret
RESEND_INBOUND_DOMAIN=

# ------------------------------------------------------------------------------
# 6. GOOGLE OAUTH (Provider-obtained)
# ------------------------------------------------------------------------------
# Optional (required if Google Sign-In is enabled):
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 7. META / WHATSAPP INBOX (Optional, Provider-obtained, Backend-only)
# ------------------------------------------------------------------------------
META_APP_ID=replace-with-your-meta-app-id
META_APP_SECRET=replace-with-your-meta-app-secret
META_WEBHOOK_VERIFY_TOKEN=generate-a-long-random-webhook-verification-token
META_LOGIN_CONFIG_ID=replace-with-your-meta-facebook-login-business-configuration-id
META_GRAPH_API_VERSION=v26.0
META_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# ------------------------------------------------------------------------------
# 8. RAZORPAY BILLING & SUBSCRIPTIONS (Provider-obtained)
# ------------------------------------------------------------------------------
# Backend-only secrets:
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
# Optional pre-created Razorpay Plan IDs (auto-created via API if omitted):
RAZORPAY_PLAN_STARTER_ID=
RAZORPAY_PLAN_GROWTH_ID=
RAZORPAY_PLAN_BUSINESS_ID=

# ------------------------------------------------------------------------------
# 9. FRONTEND PUBLIC VARIABLES (apps/web — Safe to expose in browser bundle)
# ------------------------------------------------------------------------------
WEB_PORT=3000
# Required: Public API origin (e.g. https://api-complaints.nomaanos.org)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Optional: Public AI health URL (leave empty in production if AI is kept internal)
NEXT_PUBLIC_AI_URL=http://localhost:8001
# Optional: Public Google OAuth Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
# Required for Razorpay Checkout UI: Razorpay Key ID (public key only, NEVER key secret)
NEXT_PUBLIC_RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
