# ==============================================================================
# services/api — Express Backend API Environment Variables (Server-Only Secrets)
# ==============================================================================

# Required
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://user:password@ep-example.neon.tech/nomaanos?sslmode=require
SESSION_SECRET=replace-with-48-byte-base64-random-secret
WEB_ORIGIN=https://complaints.nomaanos.org
PUBLIC_FORM_BASE_URL=https://complaints.nomaanos.org/contact

# Service-to-service AI communication (Required for AI classification)
AI_SERVICE_URL=https://your-ai-service.koyeb.app
AI_SERVICE_SECRET=replace-with-internal-random-shared-secret
AI_SERVICE_TIMEOUT_MS=30000

# Encryption key for integration webhooks/inbound email (Required if using integrations/inbound email)
INTEGRATION_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# Email delivery — Resend (Provider-obtained)
EMAIL_FROM=NomaanOS <noreply@nomaanos.org>
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_WEBHOOK_SECRET=
RESEND_INBOUND_DOMAIN=

# Google OAuth (Optional, Provider-obtained)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay Subscriptions & Webhooks (Provider-obtained)
RAZORPAY_KEY_ID=replace-with-your-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
RAZORPAY_PLAN_STARTER_ID=
RAZORPAY_PLAN_GROWTH_ID=
RAZORPAY_PLAN_BUSINESS_ID=

# Meta / WhatsApp Inbox (Optional, Provider-obtained)
PUBLIC_API_BASE_URL=https://api-complaints.nomaanos.org
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_LOGIN_CONFIG_ID=
META_GRAPH_API_VERSION=v26.0
META_TOKEN_ENCRYPTION_KEY=
